# --- ANTHROPIC ---
# Required for the parser, matcher, and tailor (Phases 2-5).
# Polling alone (Phase 1) works without this.
ANTHROPIC_API_KEY=

# --- GMAIL SMTP (used to send applications + daily digest) ---
# 1. Enable 2-Step Verification on the Google account.
# 2. https://myaccount.google.com/apppasswords → create "Jobly" app password.
# 3. Paste the 16-character app password (no spaces) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where to deliver the daily digest. Usually the same as SMTP_USER.
DIGEST_TO=

# --- IMAP (placeholder — Phase 6 IMAP adapters not built yet) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- SCHEDULING ---
TIMEZONE=Africa/Nairobi
POLL_CRON=*/30 * * * *
DIGEST_CRON=0 19 * * *

# Contact email embedded in the User-Agent header for polite scraping.
SCRAPER_CONTACT_EMAIL=
