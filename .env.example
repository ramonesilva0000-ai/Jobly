# Phase 2 needs ANTHROPIC_API_KEY for the parser. SMTP/IMAP are placeholders
# for later phases. The poller still works without ANTHROPIC_API_KEY — it
# just skips the parse step and logs a warning.

ANTHROPIC_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

DIGEST_TO=
TIMEZONE=Africa/Nairobi

# Cron expressions (UTC unless TIMEZONE is honored by your runtime).
POLL_CRON=*/30 * * * *
DIGEST_CRON=0 19 * * *

# Contact email embedded in the User-Agent header for polite scraping.
SCRAPER_CONTACT_EMAIL=
